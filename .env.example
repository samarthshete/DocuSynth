DATABASE_URL=postgresql+psycopg://<db_user>:<db_password>@postgres:5432/<db_name>
REDIS_URL=redis://redis:6379/0
RAG_SERVICE_URL=http://python-rag:8000
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRATION_SECONDS=3600

# Runtime mode A (validated local mode)
LLM_PROVIDER=ollama
LOCAL_LLM_FAST_MODE=true
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5:3b

# Runtime mode B (cloud demo mode)
# LLM_PROVIDER=gemini
# LOCAL_LLM_FAST_MODE=false
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_API_KEY=replace_with_gemini_api_key

# Keep this empty for local Ollama-only runs
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=

COUNCIL_MODEL_1=arcee-ai/trinity-large-preview:free
COUNCIL_MODEL_2=stepfun/step-3.5-flash:free
COUNCIL_MODEL_3=nvidia/nemotron-3-nano-30b-a3b:free
CHAIRMAN_MODEL=gemini-3-flash-preview

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_TIMEOUT=120
STAGE_TIMEOUT=30
MOCK_LLM=true
RATE_LIMIT_RPS=5
RATE_LIMIT_WINDOW_SECONDS=60
SEMANTIC_CACHE_THRESHOLD=0.85
TOP_K_CHUNKS=5

POSTGRES_USER=<db_user>
POSTGRES_PASSWORD=<db_password>
POSTGRES_DB=<db_name>

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin