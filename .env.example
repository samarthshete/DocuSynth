DATABASE_URL=postgresql+psycopg://docusynth:docusynth@postgres:5432/docusynth
REDIS_URL=redis://redis:6379/0
RAG_SERVICE_URL=http://python-rag:8000
JWT_SECRET=replace_with_openssl_rand_hex_32
JWT_EXPIRATION_SECONDS=3600

GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

COUNCIL_MODEL_1=arcee-ai/trinity-large-preview:free
COUNCIL_MODEL_2=stepfun/step-3.5-flash:free
COUNCIL_MODEL_3=nvidia/nemotron-3-nano-30b-a3b:free
CHAIRMAN_MODEL=gemini-3-flash-preview

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LLM_TIMEOUT=120
STAGE_TIMEOUT=30
MOCK_LLM=true
LLM_PROVIDER=ollama
LOCAL_LLM_FAST_MODE=true
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1/chat/completions
OLLAMA_MODEL=qwen2.5:3b
RATE_LIMIT_RPS=5
RATE_LIMIT_WINDOW_SECONDS=60
SEMANTIC_CACHE_THRESHOLD=0.85
TOP_K_CHUNKS=5

POSTGRES_USER=docusynth
POSTGRES_PASSWORD=docusynth
POSTGRES_DB=docusynth

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin